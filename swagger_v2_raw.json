{
    "swagger":  "2.0",
    "info":  {
                 "title":  "Account \u0026 Document Integration API (Nintex Compatible)",
                 "description":  "REST API for Nintex Workflows to query Customer Accounts and Document Signatures with Base64 encoded file contents.",
                 "version":  "v1"
             },
    "paths":  {
                  "/api/Accounts/{accountNo}":  {
                                                    "get":  {
                                                                "tags":  [
                                                                             "Accounts"
                                                                         ],
                                                                "summary":  "Retrieves Account and Customer information for a given Account Number.",
                                                                "produces":  [
                                                                                 "application/json"
                                                                             ],
                                                                "parameters":  [
                                                                                   {
                                                                                       "in":  "path",
                                                                                       "name":  "accountNo",
                                                                                       "description":  "The Account Number to look up (e.g. ACC1001)",
                                                                                       "required":  true,
                                                                                       "type":  "string"
                                                                                   }
                                                                               ],
                                                                "responses":  {
                                                                                  "200":  {
                                                                                              "description":  "OK",
                                                                                              "schema":  {
                                                                                                             "$ref":  "#/definitions/AccountDto"
                                                                                                         }
                                                                                          },
                                                                                  "404":  {
                                                                                              "description":  "Not Found",
                                                                                              "schema":  {
                                                                                                             "$ref":  "#/definitions/ProblemDetails"
                                                                                                         }
                                                                                          }
                                                                              }
                                                            }
                                                },
                  "/api/accounts/{accountNo}/documents/signature":  {
                                                                        "get":  {
                                                                                    "tags":  [
                                                                                                 "Documents"
                                                                                             ],
                                                                                    "summary":  "Retrieves the Signature document for the specified Account Number with Base64-encoded file content for Nintex mapping.",
                                                                                    "produces":  [
                                                                                                     "application/json"
                                                                                                 ],
                                                                                    "parameters":  [
                                                                                                       {
                                                                                                           "in":  "path",
                                                                                                           "name":  "accountNo",
                                                                                                           "description":  "The Account Number associated with the signature document (e.g. ACC1001)",
                                                                                                           "required":  true,
                                                                                                           "type":  "string"
                                                                                                       }
                                                                                                   ],
                                                                                    "responses":  {
                                                                                                      "200":  {
                                                                                                                  "description":  "OK",
                                                                                                                  "schema":  {
                                                                                                                                 "$ref":  "#/definitions/DocumentSignatureDto"
                                                                                                                             }
                                                                                                              },
                                                                                                      "404":  {
                                                                                                                  "description":  "Not Found",
                                                                                                                  "schema":  {
                                                                                                                                 "$ref":  "#/definitions/ProblemDetails"
                                                                                                                             }
                                                                                                              }
                                                                                                  }
                                                                                }
                                                                    }
              },
    "definitions":  {
                        "AccountDto":  {
                                           "description":  "Represents the Account and Customer information returned to Nintex / API clients.",
                                           "type":  "object",
                                           "properties":  {
                                                              "accountNo":  {
                                                                                "description":  "Unique Account Number",
                                                                                "type":  "string"
                                                                            },
                                                              "customerId":  {
                                                                                 "description":  "Customer Identifier",
                                                                                 "type":  "string"
                                                                             },
                                                              "customerName":  {
                                                                                   "description":  "Full Name of the Customer",
                                                                                   "type":  "string"
                                                                               },
                                                              "accountType":  {
                                                                                  "description":  "Type of Account (e.g. Savings, Checking, Corporate)",
                                                                                  "type":  "string"
                                                                              },
                                                              "accountStatus":  {
                                                                                    "description":  "Current status of the Account (e.g. Active, Pending, Suspended)",
                                                                                    "type":  "string"
                                                                                },
                                                              "branch":  {
                                                                             "description":  "Branch name where account is registered",
                                                                             "type":  "string"
                                                                         }
                                                          },
                                           "additionalProperties":  false
                                       },
                        "DocumentSignatureDto":  {
                                                     "description":  "Represents the Document Signature record with Base64-encoded binary content wrapped in a standard JSON object for Nintex mapping.",
                                                     "type":  "object",
                                                     "properties":  {
                                                                        "documentId":  {
                                                                                           "format":  "int32",
                                                                                           "description":  "Unique Document ID",
                                                                                           "type":  "integer"
                                                                                       },
                                                                        "accountNo":  {
                                                                                          "description":  "Account Number associated with this signature document",
                                                                                          "type":  "string"
                                                                                      },
                                                                        "documentType":  {
                                                                                             "description":  "Type of document (e.g. Signature)",
                                                                                             "type":  "string"
                                                                                         },
                                                                        "documentName":  {
                                                                                             "description":  "Document Name",
                                                                                             "type":  "string"
                                                                                         },
                                                                        "documentUrl":  {
                                                                                            "description":  "External or Storage URL of the document",
                                                                                            "type":  "string"
                                                                                        },
                                                                        "createdDate":  {
                                                                                            "format":  "date-time",
                                                                                            "description":  "Timestamp when document was created",
                                                                                            "type":  "string"
                                                                                        },
                                                                        "fileDataBase64":  {
                                                                                               "description":  "Base64 encoded file attachment content wrapped inside standard JSON object for Nintex database buffer processing",
                                                                                               "type":  "string"
                                                                                           },
                                                                        "fileName":  {
                                                                                         "description":  "Original filename for Nintex binary file creation",
                                                                                         "type":  "string"
                                                                                     },
                                                                        "contentType":  {
                                                                                            "description":  "MIME Content Type (e.g. image/png, application/pdf)",
                                                                                            "type":  "string"
                                                                                        }
                                                                    },
                                                     "additionalProperties":  false
                                                 },
                        "ProblemDetails":  {
                                               "type":  "object",
                                               "properties":  {
                                                                  "type":  {
                                                                               "type":  "string"
                                                                           },
                                                                  "title":  {
                                                                                "type":  "string"
                                                                            },
                                                                  "status":  {
                                                                                 "format":  "int32",
                                                                                 "type":  "integer"
                                                                             },
                                                                  "detail":  {
                                                                                 "type":  "string"
                                                                             },
                                                                  "instance":  {
                                                                                   "type":  "string"
                                                                               }
                                                              },
                                               "additionalProperties":  {

                                                                        }
                                           }
                    }
}
