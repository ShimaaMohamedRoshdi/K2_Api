{
  "swagger": "2.0",
  "info": {
    "title": "Account & Document Integration API",
    "description": "REST API for Nintex K2 Workflows",
    "version": "1.0.0"
  },
  "host": "yourdomain.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/Accounts/{accountNo}": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get Account by Number",
        "operationId": "GetAccountByNo",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "accountNo",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/AccountDto"
            }
          }
        }
      }
    },
    "/api/accounts/{accountNo}/documents/signature": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get Document Signature",
        "operationId": "GetSignatureDocument",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "accountNo",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/DocumentSignatureDto"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AccountDto": {
      "type": "object",
      "properties": {
        "AccountNo": {
          "type": "string"
        },
        "CustomerId": {
          "type": "string"
        },
        "CustomerName": {
          "type": "string"
        },
        "AccountType": {
          "type": "string"
        },
        "AccountStatus": {
          "type": "string"
        },
        "Branch": {
          "type": "string"
        }
      }
    },
    "DocumentSignatureDto": {
      "type": "object",
      "properties": {
        "DocumentId": {
          "type": "integer",
          "format": "int32"
        },
        "AccountNo": {
          "type": "string"
        },
        "DocumentType": {
          "type": "string"
        },
        "DocumentName": {
          "type": "string"
        },
        "DocumentUrl": {
          "type": "string"
        },
        "CreatedDate": {
          "type": "string",
          "format": "date-time"
        },
        "FileDataBase64": {
          "type": "string"
        },
        "FileName": {
          "type": "string"
        },
        "ContentType": {
          "type": "string"
        }
      }
    }
  }
}
