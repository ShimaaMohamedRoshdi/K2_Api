{
  "swagger": "2.0",
  "info": {
    "title": "Account & Document Integration API (Nintex Compatible)",
    "description": "REST API for Nintex Workflows to query Customer Accounts and Document Signatures with Base64 encoded file contents.",
    "version": "v1"
  },
  "host": "yourdomain.com",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/Accounts/{accountNo}": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Retrieves Account and Customer information for a given Account Number.",
        "operationId": "GetAccountByNo",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "accountNo",
            "in": "path",
            "description": "The Account Number to look up (e.g. ACC1001)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "title": "AccountDto",
              "properties": {
                "accountNo": {
                  "type": "string",
                  "description": "Unique Account Number"
                },
                "customerId": {
                  "type": "string",
                  "description": "Customer Identifier"
                },
                "customerName": {
                  "type": "string",
                  "description": "Full Name of the Customer"
                },
                "accountType": {
                  "type": "string",
                  "description": "Type of Account (e.g. Savings, Checking, Corporate)"
                },
                "accountStatus": {
                  "type": "string",
                  "description": "Current status of the Account (e.g. Active, Pending, Suspended)"
                },
                "branch": {
                  "type": "string",
                  "description": "Branch name where account is registered"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountNo}/documents/signature": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Retrieves the Signature document for the specified Account Number with Base64-encoded file content for Nintex mapping.",
        "operationId": "GetSignatureDocument",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "accountNo",
            "in": "path",
            "description": "The Account Number associated with the signature document (e.g. ACC1001)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "title": "DocumentSignatureDto",
              "properties": {
                "documentId": {
                  "type": "integer",
                  "format": "int32",
                  "description": "Unique Document ID"
                },
                "accountNo": {
                  "type": "string",
                  "description": "Account Number associated with this signature document"
                },
                "documentType": {
                  "type": "string",
                  "description": "Type of document (e.g. Signature)"
                },
                "documentName": {
                  "type": "string",
                  "description": "Document Name"
                },
                "documentUrl": {
                  "type": "string",
                  "description": "External or Storage URL of the document"
                },
                "createdDate": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp when document was created"
                },
                "fileDataBase64": {
                  "type": "string",
                  "description": "Base64 encoded file attachment content wrapped inside standard JSON object for Nintex database buffer processing"
                },
                "fileName": {
                  "type": "string",
                  "description": "Original filename for Nintex binary file creation"
                },
                "contentType": {
                  "type": "string",
                  "description": "MIME Content Type (e.g. image/png, application/pdf)"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AccountDto": {
      "type": "object",
      "properties": {
        "accountNo": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "accountType": {
          "type": "string"
        },
        "accountStatus": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "DocumentSignatureDto": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "integer",
          "format": "int32"
        },
        "accountNo": {
          "type": "string"
        },
        "documentType": {
          "type": "string"
        },
        "documentName": {
          "type": "string"
        },
        "documentUrl": {
          "type": "string"
        },
        "createdDate": {
          "type": "string",
          "format": "date-time"
        },
        "fileDataBase64": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        }
      }
    }
  }
}
